{
  "manifest_version": 3,
  "name": "Capture Full Page",
  "version": "5.3.0",
  "description": "Capture full pages reliably from the context menu or extension button, including app shells and nested scrolling content.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capture full page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "offscreen.js",
      "service-worker.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capture-full-page@ohokthisisfine.github",
      "strict_min_version": "126.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
